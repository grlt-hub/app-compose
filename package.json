  "repository": {
    "type": "git",
    "url": "git+https://github.com/grlt-hub/app-compose.git"
  },
  "type": "module",
  "scripts": {
    "doc:dev": "pnpm build && pnpm --dir ./documentation run dev",
    "doc:build": "pnpm build && pnpm --dir ./documentation run build",
    "build": "pnpm -r --filter='!./documentation' build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "pnpm -r --parallel test",
    "lint": "pnpm -r --parallel lint",
    "lint:fix": "pnpm -r --parallel lint:fix",
    "fmt": "oxfmt .",
    "release": "node ./scripts/release.ts"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "bumpp": "12.3.0",
    "knip": "6.43.0",
    "lefthook": "2.2.2",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "semver": "7.8.5",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "packageManager": "pnpm@11.6.0+sha512.9a36518224080c6fe5165afdcfe79bfa118c29be703f3f462b1e32efe1e98e47e8750b148e08286250aad4113cc7993ca413c4e2cd447752708c2ee5751bc95f"
